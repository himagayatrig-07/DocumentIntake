# Copy to .env (git ignores it): cp .env.example .env

# Local AWS emulator (moto server). Leave unset only when deploying to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
# moto accepts any credentials; these are dummy values.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Needed from step 2 (LLM extraction). Never commit a real key.
ANTHROPIC_API_KEY=
